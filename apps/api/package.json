{
  "name": "@snoutbook/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/index.ts",
    "start": "tsx src/index.ts",
    "worker": "tsx --env-file=../../.env src/worker.ts",
    "worker:prod": "tsx src/worker.ts",
    "migrate": "tsx --env-file=../../.env src/scripts/migrate.ts",
    "seed": "tsx --env-file=../../.env src/scripts/seed.ts",
    "bill-sms-overage": "tsx src/scripts/bill-sms-overage.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.395.0",
    "@aws-sdk/s3-request-presigner": "^3.395.0",
    "@snoutbook/shared": "*",
    "express": "^4.18.2",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.11.3",
    "postmark": "^3.0.19",
    "stripe": "^14.12.0",
    "tsx": "^3.12.7",
    "twilio": "^4.16.0",
    "zod": "^3.22.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.17",
    "@types/multer": "^1.4.11",
    "@types/pg": "^8.10.2"
  }
}
