{
  "name": "@snoutbook/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/index.ts",
    "start": "tsx src/index.ts",
    "worker": "tsx --env-file=../../.env src/worker.ts",
    "worker:prod": "tsx src/worker.ts",
    "migrate": "tsx --env-file=../../.env src/scripts/migrate.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@snoutbook/shared": "*",
    "express": "^4.18.2",
    "pg": "^8.11.3",
    "tsx": "^3.12.7",
    "twilio": "^4.16.0",
    "zod": "^3.22.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.17",
    "@types/pg": "^8.10.2"
  }
}
