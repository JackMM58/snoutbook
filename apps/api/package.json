{
  "name": "@snoutbook/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/index.ts",
    "start": "tsx src/index.ts",
    "worker": "tsx --env-file=../../.env src/worker.ts",
    "worker:prod": "tsx src/worker.ts",
    "migrate": "tsx --env-file=../../.env src/scripts/migrate.ts",
    "seed": "tsx --env-file=../../.env src/scripts/seed.ts",
    "bill-sms-overage": "tsx src/scripts/bill-sms-overage.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@snoutbook/shared": "*",
    "express": "^4.21.2",
    "multer": "^2.0.1",
    "pg": "^8.13.1",
    "postmark": "^4.0.5",
    "stripe": "^17.5.0",
    "tsx": "^4.19.2",
    "twilio": "^5.4.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/pg": "^8.11.10"
  }
}
