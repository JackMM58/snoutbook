# Copy to .env for local development. Production values live in the hosting platform.

NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://snoutbook:snoutbook@localhost:5432/snoutbook_dev
# At least 32 characters. `openssl rand -base64 48` works.
SESSION_SECRET=replace_me_with_a_long_random_string_for_local_dev

# Where the web app and API are reachable. Used in texts, emails and Stripe return URLs.
APP_BASE_URL=http://localhost:5173
API_BASE_URL=http://localhost:4000

# Stripe (Connect platform account, test mode)
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Twilio
TWILIO_ACCOUNT_SID=ACreplace_me
TWILIO_AUTH_TOKEN=replace_me
TWILIO_MESSAGING_SERVICE_SID=MGreplace_me

# Postmark
POSTMARK_SERVER_TOKEN=replace_me
POSTMARK_FROM_EMAIL=reminders@example.com

# File uploads (pet photos, vaccine certificates). S3_ENDPOINT is only for local MinIO.
S3_BUCKET=snoutbook-dev-uploads
S3_REGION=us-west-2
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=replace_me
S3_SECRET_ACCESS_KEY=replace_me

# Worker
WORKER_POLL_MS=5000
WORKER_BATCH_SIZE=25

# Optional: password for the seeded owner account (npm run seed)
SEED_OWNER_PASSWORD=
